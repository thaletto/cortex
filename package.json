{
  "name": "thaletto",
  "private": true,
  "workspaces": ["packages/*"],
  "version": "1.0.1",
  "type": "module",
  "license": "MIT",
  "description": "The ORM for Vector Databases",
  "scripts": {
    "test": "vitest run",
