{
  "name": "cortex",
  "private": true,
  "workspaces": ["packages/*"],
  "version": "0.1.3",
  "type": "module",
  "license": "MIT",
  "description": "Developer-controlled context memory layer for Effect applications",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "bun run example/index.ts",
    "docs": "bun run --cwd docs dev",
    "docs:build": "bun run --cwd docs build"
  },
  "devDependencies": {
    "@cortex/cortex": "workspace:*",
    "@cortex/zvec": "workspace:*",
    "@effect/language-service": "^0.86.2",
    "@effect/platform-bun": "^4.0.0-beta.70",
    "@effect/platform-node": "^4.0.0-beta.70",
    "@effect/vitest": "^4.0.0-beta.70",
    "@types/bun": "1.3.14",
    "bun": "^1.3.14",
    "effect": "^4.0.0-beta.70",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "typescript": "^6.0.3",
    "effect": "^4.0.0-beta.66"
  }
}
