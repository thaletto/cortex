    "@effect/language-service": "^0.87.2",
    "@effect/platform-bun": "^0.91.2",
    "@effect/platform-node": "^0.108.1",
    "@effect/vitest": "^0.30.0",
    "@types/bun": "1.3.14",
    "bun": "^1.3.14",
    "effect": "^3.22.1",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "typescript": "^7.0.2",
    "effect": "^3.22.1"
  }
}
